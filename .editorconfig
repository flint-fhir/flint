root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{go,go.tmpl}]
indent_style = tab
indent_size = 4

[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2

# buf format is the authority for proto layout (emits spaces)
[*.proto]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 4

# A markdown hard line break is two trailing spaces, and continuation lines
# are indented to the list marker width rather than a fixed step.
[*.md]
trim_trailing_whitespace = false
indent_size = unset
