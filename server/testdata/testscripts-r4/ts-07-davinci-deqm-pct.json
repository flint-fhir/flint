{
  "resourceType": "TestScript",
  "id": "ts-07-davinci-deqm-pct",
  "url": "http://flint.fhir.org/TestScript/ts-07-davinci-deqm-pct",
  "version": "0.7.0",
  "name": "DaVinciDEQMDataExchangeCareGapsAndPCT",
  "title": "HL7 Da Vinci DEQM ($submit-data, $collect-data, $care-gaps) & Patient Cost Transparency ($gfe-submit, $pct-aeob-summary)",
  "status": "active",
  "contained": [
    {
      "resourceType": "Patient",
      "id": "pat-deqm-pct",
      "active": true,
      "gender": "female",
      "birthDate": "1974-09-22",
      "name": [{"use": "official", "family": "QualityTransparency", "given": ["Clara"]}]
    },
    {
      "resourceType": "Measure",
      "id": "meas-deqm-bp",
      "url": "http://flint.fhir.org/Measure/deqm-bp-ts07",
      "version": "1.0.0",
      "name": "DEQMBloodPressureControlTS07",
      "status": "active",
      "scoring": {
        "coding": [
          {"system": "http://terminology.hl7.org/CodeSystem/measure-scoring", "code": "proportion"}
        ]
      }
    },
    {
      "resourceType": "Parameters",
      "id": "params-deqm-submit",
      "parameter": [
        {
          "name": "measureReport",
          "resource": {
            "resourceType": "MeasureReport",
            "id": "mr-submit-ts07",
            "status": "complete",
            "type": "data-collection",
            "measure": "http://flint.fhir.org/Measure/deqm-bp-ts07",
            "subject": {"reference": "Patient/${deqmPatId}"},
            "date": "2026-03-01",
            "period": {"start": "2026-01-01", "end": "2026-12-31"}
          }
        },
        {
          "name": "resource",
          "resource": {
            "resourceType": "Observation",
            "id": "obs-submit-bp-ts07",
            "status": "final",
            "code": {
              "coding": [
                {"system": "http://loinc.org", "code": "8480-6", "display": "Systolic blood pressure"}
              ]
            },
            "subject": {"reference": "Patient/${deqmPatId}"},
            "effectiveDateTime": "2026-02-15T10:00:00Z",
            "valueQuantity": {
              "value": 124,
              "unit": "mmHg",
              "system": "http://unitsofmeasure.org",
              "code": "mm[Hg]"
            }
          }
        }
      ]
    },
    {
      "resourceType": "Parameters",
      "id": "params-pct-gfe",
      "parameter": [
        {"name": "patient", "valueString": "Patient/${deqmPatId}"}
      ]
    }
  ],
  "fixture": [
    {"id": "fx-deqm-pat", "autocreate": false, "autodelete": false, "resource": {"reference": "#pat-deqm-pct"}},
    {"id": "fx-deqm-measure", "autocreate": false, "autodelete": false, "resource": {"reference": "#meas-deqm-bp"}},
    {"id": "fx-deqm-submit", "autocreate": false, "autodelete": false, "resource": {"reference": "#params-deqm-submit"}},
    {"id": "fx-pct-gfe", "autocreate": false, "autodelete": false, "resource": {"reference": "#params-pct-gfe"}}
  ],
  "variable": [
    {"name": "deqmPatId", "expression": "Patient.id", "sourceId": "resp-deqm-pat"},
    {"name": "deqmMeasureId", "expression": "Measure.id", "sourceId": "resp-deqm-measure"}
  ],
  "setup": {
    "action": [
      {
        "operation": {
          "type": {"code": "create"},
          "resource": "Patient",
          "sourceId": "fx-deqm-pat",
          "responseId": "resp-deqm-pat"
        }
      },
      {"assert": {"response": "created"}},
      {
        "operation": {
          "type": {"code": "create"},
          "resource": "Measure",
          "sourceId": "fx-deqm-measure",
          "responseId": "resp-deqm-measure"
        }
      },
      {"assert": {"response": "created"}}
    ]
  },
  "test": [
    {
      "name": "01-DEQMSubmitDataAndCollectData",
      "description": "Verify Measure/$submit-data ingests MeasureReport + clinical Observation and Measure/{id}/$collect-data returns patient data-collection Parameters.",
      "action": [
        {
          "operation": {
            "method": "post",
            "url": "Measure/${deqmMeasureId}/$submit-data",
            "sourceId": "fx-deqm-submit"
          }
        },
        {
          "assert": {
            "response": "okay",
            "resource": "Bundle",
            "expression": "Bundle.type",
            "operator": "equals",
            "value": "transaction-response"
          }
        },
        {
          "assert": {
            "expression": "Bundle.entry.count()",
            "operator": "equals",
            "value": "2"
          }
        },
        {
          "operation": {
            "method": "get",
            "url": "Measure/${deqmMeasureId}/$collect-data",
            "params": "subject=Patient/${deqmPatId}&periodStart=2026-01-01&periodEnd=2026-12-31"
          }
        },
        {
          "assert": {
            "response": "okay",
            "resource": "Parameters",
            "expression": "Parameters.parameter[0].name",
            "operator": "equals",
            "value": "measureReport"
          }
        }
      ]
    },
    {
      "name": "02-DEQMCareGapsDocumentBundle",
      "description": "Verify Measure/$care-gaps generates a FHIR document Bundle starting with LOINC 96315-7 Care Gaps Composition.",
      "action": [
        {
          "operation": {
            "method": "get",
            "url": "Measure/$care-gaps",
            "params": "periodStart=2026-01-01&periodEnd=2026-12-31&subject=Patient/${deqmPatId}&status=open-gap,closed-gap,not-in-population"
          }
        },
        {
          "assert": {
            "response": "okay",
            "resource": "Bundle",
            "expression": "Bundle.type",
            "operator": "equals",
            "value": "document"
          }
        },
        {
          "assert": {
            "expression": "Bundle.entry.count()",
            "operator": "greaterThan",
            "value": "1"
          }
        }
      ]
    },
    {
      "name": "03-PCTGoodFaithEstimateAndAEOBSummary",
      "description": "Verify Claim/$gfe-submit produces AEOB predetermination packet Bundle and ExplanationOfBenefit/$pct-aeob-summary returns AEOB searchset.",
      "action": [
        {
          "operation": {
            "method": "post",
            "url": "Claim/$gfe-submit",
            "sourceId": "fx-pct-gfe"
          }
        },
        {
          "assert": {
            "response": "okay",
            "resource": "Bundle",
            "expression": "Bundle.type",
            "operator": "equals",
            "value": "collection"
          }
        },
        {
          "assert": {
            "expression": "Bundle.entry[0].resource.use",
            "operator": "equals",
            "value": "predetermination"
          }
        },
        {
          "operation": {
            "method": "get",
            "url": "ExplanationOfBenefit/$pct-aeob-summary",
            "params": "patient=${deqmPatId}"
          }
        },
        {
          "assert": {
            "response": "okay",
            "resource": "Bundle",
            "expression": "Bundle.type",
            "operator": "equals",
            "value": "searchset"
          }
        }
      ]
    }
  ]
}
